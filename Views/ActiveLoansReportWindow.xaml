<Window x:Class="ArisPayrollCompanion.Views.ActiveLoansReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Active Employees &amp; Pending Loans Report"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header & Export Button -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Active Employees with Pending Loans" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="btnExportExcel" Content="📊 Export to Excel"
                    Width="150" Height="35" Background="#27AE60" Foreground="White"
                    FontWeight="Bold" Click="btnExportExcel_Click" Cursor="Hand"/>
        </Grid>

        <!-- Filters (Department & Category) -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Filter by Department:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <ComboBox x:Name="cmbDepartment" Height="30" SelectionChanged="Filter_SelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Filter by Category:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <ComboBox x:Name="cmbCategory" Height="30" SelectionChanged="Filter_SelectionChanged"/>
            </StackPanel>

            <Button Grid.Column="4" Content="🔄 Refresh Data" Width="120" Height="30" VerticalAlignment="Bottom"
                    Click="BtnRefresh_Click" Cursor="Hand"/>
        </Grid>

        <!-- DataGrid -->
        <DataGrid x:Name="dgReport" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  AlternatingRowBackground="#F9F9F9" RowHeight="30" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Card No" Binding="{Binding CardNumber}" Width="90"/>
                <DataGridTextColumn Header="Emp Code" Binding="{Binding EmployeeCode}" Width="100"/>
                <DataGridTextColumn Header="Employee Name" Binding="{Binding EmployeeName}" Width="250"/>
                <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="150"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150"/>
                <DataGridTextColumn Header="Pending Loan Amount" Binding="{Binding PendingLoanAmount, StringFormat={}{0:N2}}" Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#C0392B"/>
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,10,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer / Totals -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="txtTotalActive" Text="Total Active with Loans: 0" FontWeight="Bold" FontSize="14" Margin="0,0,25,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="txtTotalLoan" Text="Total Pending Loans: ₹0.00" FontWeight="Bold" FontSize="14" Foreground="#C0392B" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>