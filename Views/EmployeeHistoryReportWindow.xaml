<Window x:Class="ArisPayrollCompanion.Views.EmployeeHistoryReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee History Report" Height="650" Width="950" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Report Settings" Grid.Row="0" Margin="0,0,0,15" Padding="10" FontWeight="SemiBold">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Data File (MONDATA): " VerticalAlignment="Center" FontWeight="Normal" FontSize="14" Width="150"/>
                    <TextBox x:Name="txtMonDataPath" Width="450" Height="28" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F0F0F0" Foreground="#333"/>
                    <Button x:Name="btnBrowseMonData" Content="📂 Browse" Width="100" Height="28" Margin="10,0,0,0" Click="btnBrowseMonData_Click" Cursor="Hand"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Row="1">
                    <TextBlock Text="Select Employee: " VerticalAlignment="Center" FontWeight="Normal" FontSize="14" Width="150"/>
                    <ComboBox x:Name="cmbEmployee" Width="250" Height="28" Margin="0,0,20,0" IsEditable="True" StaysOpenOnEdit="True"/>

                    <TextBlock Text="From: " VerticalAlignment="Center" FontWeight="Normal" FontSize="14"/>
                    <DatePicker x:Name="dpStart" Width="110" Margin="5,0,15,0"/>

                    <TextBlock Text="To: " VerticalAlignment="Center" FontWeight="Normal" FontSize="14"/>
                    <DatePicker x:Name="dpEnd" Width="110" Margin="5,0,20,0"/>

                    <Button x:Name="btnRunReport" Content="🏃 Run" Width="90" Height="35" Background="#0078D7" Foreground="White" FontWeight="Bold" Click="btnRunReport_Click" Cursor="Hand"/>
                    <Button x:Name="btnExportExcel" Content="📊 Export" Width="90" Height="35" Background="#27AE60" Foreground="White" FontWeight="Bold" Margin="10,0,0,0" Click="btnExportExcel_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <DataGrid x:Name="dgHistory" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" AlternatingRowBackground="#F9F9F9">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding DateStr}" Width="150" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="In Time" Binding="{Binding InTime}" Width="150"/>
                <DataGridTextColumn Header="Out Time" Binding="{Binding OutTime}" Width="150"/>

                <DataGridTemplateColumn Header="Status" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="Bold" VerticalAlignment="Center" Padding="5,0,0,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>