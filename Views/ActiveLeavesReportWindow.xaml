<Window x:Class="ArisPayrollCompanion.Views.ActiveLeavesReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Current Active Leaves Report" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F5F6FA">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Summary Dashboard -->
        <Border Grid.Row="0" Background="#8E44AD" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Total Employees Currently on Leave" Foreground="#E8DAEF" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtTotalOnLeave" Text="0" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Employees Overdue / Late" Foreground="#E8DAEF" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtTotalOverdue" Text="0" Foreground="#FF5252" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Data Grid -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Live Active Leaves Tracker" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

            <Border Grid.Row="1" BorderBrush="#D0D3D4" BorderThickness="1">
                <DataGrid x:Name="dgActiveLeaves" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          HeadersVisibility="Column" Background="White" RowBackground="White" 
                          AlternatingRowBackground="#F9F9F9" GridLinesVisibility="Horizontal" RowHeight="32" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Emp Code" Binding="{Binding EmpCode}" Width="90"/>
                        <DataGridTextColumn Header="Employee Name" Binding="{Binding EmpName}" Width="1.5*"/>
                        <DataGridTextColumn Header="Departure" Binding="{Binding DepartureDate}" Width="110"/>
                        <DataGridTextColumn Header="Expected Return" Binding="{Binding ExpectedReturn}" Width="110"/>

                        <!-- Dynamic Colored Late Days Column -->
                        <DataGridTemplateColumn Header="Late Days" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LateDaysText}" Foreground="{Binding LateColor}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Reason / Notes" Binding="{Binding Reason}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Export Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btnExportExcel" Content="Export to Excel" Width="120" Height="35" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnExportExcel_Click"/>
        </StackPanel>
    </Grid>
</Window>