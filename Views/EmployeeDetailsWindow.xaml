<Window x:Class="ArisPayrollCompanion.Views.EmployeeDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Details" 
        Height="550" 
        Width="780"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock 
            Text="Employee Details" 
            FontSize="22" 
            FontWeight="Bold" 
            Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <Label Content="Employee Name:" FontWeight="SemiBold" Padding="0,0,0,2"/>
            <TextBlock x:Name="txtName" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Label Content="Employee Code:" FontWeight="SemiBold" Padding="0,0,0,2"/>
                    <TextBlock x:Name="txtCode" FontSize="14" Margin="0,0,0,10"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Label Content="Card Number:" FontWeight="SemiBold" Padding="0,0,0,2"/>
                    <TextBlock x:Name="txtCard" FontSize="14" Margin="0,0,0,10"/>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Label Content="Department:" FontWeight="SemiBold" Padding="0,0,0,2"/>
                    <TextBlock x:Name="txtDept" FontSize="14" Margin="0,0,0,10"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Label Content="Designation:" FontWeight="SemiBold" Padding="0,0,0,2"/>
                    <TextBlock x:Name="txtDesig" FontSize="14" Margin="0,0,0,10"/>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Label Content="Category:" FontWeight="SemiBold" Padding="0,0,0,2"/>
                    <TextBlock x:Name="txtCategory" FontSize="14" Margin="0,0,0,10"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Label Content="Status:" FontWeight="SemiBold" Padding="0,0,0,2"/>
                    <TextBlock x:Name="txtStatus" FontSize="14" Margin="0,0,0,10"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnLoanLedger" Content="Loan Ledger" Width="95" Height="32" Click="btnLoanLedger_Click" Background="#8E44AD" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="btnAdvance" Content="Advances" Width="95" Height="32" Margin="10,0,0,0" Click="btnAdvance_Click" Background="#E67E22" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="btnLeaves" Content="Leaves" Width="80" Height="32" Margin="10,0,0,0" Click="btnLeaves_Click" Background="#D35400" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="btnDocuments" Content="Documents" Width="95" Height="32" Margin="10,0,0,0" Click="btnDocuments_Click" Background="#27AE60" Foreground="White" FontWeight="Bold"/>

            <Button x:Name="btnSummary" Content="360 Report" Width="90" Height="32" Margin="10,0,0,0" Click="btnSummary_Click" Background="#34495E" Foreground="White" FontWeight="Bold"/>

            <Button x:Name="btnEdit" Content="Edit" Width="80" Height="32" Margin="10,0,0,0" Click="btnEdit_Click" Background="#2980B9" Foreground="White" FontWeight="Bold"/>
            <Button Content="Close" Width="80" Height="32" Margin="10,0,0,0" Click="btnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>