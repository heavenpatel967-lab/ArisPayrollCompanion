<Window x:Class="ArisPayrollCompanion.Views.ComplianceDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compliance &amp; Missing Data Audit" 
        Height="600" Width="900" 
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Compliance &amp; Data Audit" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

        <!-- Summary KPI Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Missing Photos Card -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="5" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Missing Photos" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtMissingPhotos" Text="0" FontSize="28" FontWeight="Bold" Foreground="#E74C3C" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Missing Aadhar Card -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="5" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Missing Aadhar Info" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtMissingAadhar" Text="0" FontSize="28" FontWeight="Bold" Foreground="#E74C3C" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Missing Village Info -->
            <Border Grid.Column="4" Background="White" CornerRadius="8" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="5" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Missing Village Info" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtMissingVillage" Text="0" FontSize="28" FontWeight="Bold" Foreground="#E74C3C" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- The Audit DataGrid -->
        <GroupBox Grid.Row="2" Header="Employee Red Flag List" Padding="10" Background="White">
            <DataGrid x:Name="dgCompliance" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" 
                      Background="White" RowHeight="30" AlternatingRowBackground="#F9F9F9">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Emp Code" Binding="{Binding EmployeeCode}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Employee Name" Binding="{Binding EmployeeName}" Width="200"/>

                    <!-- Flag Columns -->
                    <DataGridTextColumn Header="Profile Photo" Binding="{Binding PhotoStatus}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding PhotoColor}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Aadhar Info" Binding="{Binding AadharStatus}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding AadharColor}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Native Village" Binding="{Binding VillageStatus}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding VillageColor}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Total Flags" Binding="{Binding FlagCount}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>