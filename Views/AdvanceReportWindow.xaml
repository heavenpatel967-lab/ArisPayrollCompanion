<Window x:Class="ArisPayrollCompanion.Views.AdvanceReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monthly Advance Ledger" Height="650" Width="980" 
        WindowStartupLocation="CenterScreen" Background="#F5F6FA">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Summary Dashboard -->
        <Border Grid.Row="0" Background="#2980B9" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Advances -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Total Advances Taken" Foreground="#D6EAF8" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtTopTotalAdvance" Text="₹ 0.00" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Dynamic Limit Editor -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Set Monthly Limit (₹)" Foreground="#D6EAF8" FontSize="14" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtAdvanceLimit" Text="5000" TextChanged="txtAdvanceLimit_TextChanged" 
                             Background="Transparent" Foreground="#F1C40F" FontSize="22" FontWeight="Bold" 
                             BorderBrush="#D6EAF8" BorderThickness="0,0,0,2" Margin="0,5,40,0" Padding="0,0,0,2"/>
                </StackPanel>

                <!-- Advance Health Overview -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Advance Health (Limit)" Foreground="#D6EAF8" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtHealthFraction" Text="0 / 0 Safe" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Last 6 Months Tracker (Round Marks) -->
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="Last 6 Months Trend" Foreground="#D6EAF8" FontSize="14" FontWeight="SemiBold"/>
                    <ItemsControl x:Name="icLast6Months" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="16" Height="16" Fill="{Binding Color}" Margin="0,0,6,0" ToolTip="{Binding Month}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Grid -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Monthly Advances Breakdown" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

            <Border Grid.Row="1" BorderBrush="#D0D3D4" BorderThickness="1">
                <DataGrid x:Name="dgAdvanceHistory" AutoGenerateColumns="False" CanUserAddRows="False" 
                          HeadersVisibility="Column" Background="White" RowBackground="White" 
                          AlternatingRowBackground="#F9F9F9" GridLinesVisibility="Horizontal"
                          RowHeight="32" FontSize="13">
                    <DataGrid.Columns>
                        <!-- Round Status Indicator -->
                        <DataGridTemplateColumn Header="Status" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="14" Height="14" Fill="{Binding StatusColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Month / Year" Binding="{Binding MonthYear}" Width="*"/>

                        <!-- Colored Advance Amount -->
                        <DataGridTemplateColumn Header="Advance Amount" Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AmountDisplay}" 
                                               Foreground="{Binding StatusColor}" 
                                               FontWeight="Bold" 
                                               VerticalAlignment="Center" Padding="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Bottom Totals -->
            <Border Grid.Row="2" Background="#EAEDED" BorderBrush="#D0D3D4" BorderThickness="1,0,1,1" Padding="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Total Lifetime Advance: " FontWeight="Bold"/>
                    <TextBlock x:Name="txtBottomTotalAdvance" Text="₹ 0.00" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Export Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0" x:Name="ActionPanel">
            <Button x:Name="btnExportExcel" Content="Export to Excel" Width="120" Height="35" Margin="0,0,10,0" 
                    Click="btnExportExcel_Click" Background="#27AE60" Foreground="White" FontWeight="Bold" 
                    BorderThickness="0" Cursor="Hand"/>

            <Button x:Name="btnExportPDF" Content="Save as PDF" Width="120" Height="35" 
                    Click="btnExportPDF_Click" Background="#E74C3C" Foreground="White" FontWeight="Bold" 
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>