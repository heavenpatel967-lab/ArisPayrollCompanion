<Window x:Class="ArisPayrollCompanion.Views.LeaveTrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Long Leave Tracker" 
        Height="650" Width="900" 
        WindowStartupLocation="CenterOwner"
        Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header & Import Button -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="txtHeader" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            <Button x:Name="btnImportLegacy" Grid.Column="1" Content="📁 Import CSV Data" Height="35" Width="150" Background="#28A745" Foreground="White" FontWeight="Bold" Click="btnImportLegacy_Click" Cursor="Hand" ToolTip="Import cleaned 5-column CSV"/>
        </Grid>

        <!-- Add/Edit Leave Section -->
        <GroupBox Grid.Row="1" Header="Log / Update Village Visit" Padding="15" Margin="0,0,0,20" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Departure Date:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,15"/>
                <DatePicker x:Name="dpDeparture" Grid.Column="1" Height="28" Margin="0,0,20,15"/>

                <TextBlock Grid.Column="2" Text="Expected Return:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,15"/>
                <DatePicker x:Name="dpExpected" Grid.Column="3" Height="28" Margin="0,0,0,15"/>

                <TextBlock Grid.Row="1" Text="Actual Return Date:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,15"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,15">
                    <DatePicker x:Name="dpActual" Height="28" Width="150"/>
                    <TextBlock Text="(Leave blank if not yet returned)" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0" FontStyle="Italic"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Reason / Notes:" VerticalAlignment="Top" FontWeight="SemiBold" Margin="0,5,10,0"/>
                <TextBox x:Name="txtReason" Grid.Row="2" Grid.Column="1" Height="50" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,20,0"/>

                <!-- Action Buttons Stacked -->
                <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button x:Name="btnCancelEdit" Content="Cancel Edit" Height="35" Width="100" Margin="0,0,10,0" Background="#95A5A6" Foreground="White" FontWeight="Bold" Click="btnCancelEdit_Click" Visibility="Collapsed" Cursor="Hand"/>
                    <Button x:Name="btnSaveLeave" Content="Save Leave Record" Height="35" Width="160" Background="#0078D7" Foreground="White" FontWeight="Bold" Click="btnSaveLeave_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Leave History -->
        <GroupBox Grid.Row="2" Header="Leave History &amp; Late Tracking" Padding="10" Background="White">
            <DataGrid x:Name="dgLeaves" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White" RowHeight="32">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Status" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="14" Height="14" Fill="{Binding StatusColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Departure" Binding="{Binding DepartureDate}" Width="100"/>
                    <DataGridTextColumn Header="Expected Return" Binding="{Binding ExpectedReturnDate}" Width="110"/>
                    <DataGridTextColumn Header="Actual Return" Binding="{Binding ActualReturnDate}" Width="100"/>

                    <DataGridTextColumn Header="Late Days" Binding="{Binding LateDaysText}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Reason / Notes" Binding="{Binding Reason}" Width="*"/>

                    <DataGridTemplateColumn Header="Action" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Edit" Click="btnEditLeave_Click" Padding="10,2" Background="#F39C12" Foreground="White" Cursor="Hand" Margin="0,0,5,0"/>
                                    <Button Content="Delete" Click="btnDeleteLeave_Click" Padding="10,2" Background="#DC3545" Foreground="White" Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>