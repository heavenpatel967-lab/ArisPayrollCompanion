<Window x:Class="ArisPayrollCompanion.Views.EmployeeDocumentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Documents" 
        Height="600" Width="800" 
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="txtHeader" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Upload Section -->
        <GroupBox Grid.Row="1" Header="Upload New Document" Padding="10" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Category:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <ComboBox x:Name="cmbCategory" Grid.Column="1" Height="28" Margin="0,0,20,0">
                    <ComboBoxItem Content="Aadhar Card" IsSelected="True"/>
                    <ComboBoxItem Content="ID Proof (Other)"/>
                    <ComboBoxItem Content="Apology Letter"/>
                    <ComboBoxItem Content="Certificate"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>

                <TextBlock Grid.Column="2" Text="Document Name:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <TextBox x:Name="txtDocName" Grid.Column="3" Height="28" Margin="0,0,20,0" VerticalContentAlignment="Center"/>

                <Button x:Name="btnBrowse" Grid.Column="4" Content="Browse File" Width="100" Height="28" Click="btnBrowse_Click"/>

                <TextBlock x:Name="txtSelectedFile" Grid.Row="1" Grid.ColumnSpan="4" Margin="0,15,0,0" Foreground="Gray" FontStyle="Italic"/>
                <Button x:Name="btnSave" Grid.Row="1" Grid.Column="4" Content="Save Document" Width="120" Height="30" Margin="0,10,0,0" Background="#0078D7" Foreground="White" FontWeight="Bold" Click="btnSave_Click"/>
            </Grid>
        </GroupBox>

        <!-- Documents List -->
        <GroupBox Grid.Row="2" Header="Uploaded Documents" Padding="10">
            <DataGrid x:Name="dgDocuments" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding UploadDate}" Width="100"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding DocumentCategory}" Width="150"/>
                    <DataGridTextColumn Header="Document Name" Binding="{Binding DocumentName}" Width="*"/>
                    <DataGridTemplateColumn Header="Action" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Updated: Added a StackPanel to hold both View and Delete buttons -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="View / Open" Click="btnOpenDocument_Click" Padding="5,2" Background="#28A745" Foreground="White" Margin="0,0,5,0"/>
                                    <Button Content="Delete" Click="btnDeleteDocument_Click" Padding="5,2" Background="#DC3545" Foreground="White"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>