<Window x:Class="ArisPayrollCompanion.Views.LoanReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Complete Loan Ledger" Height="600" Width="980"
        WindowStartupLocation="CenterScreen" Background="#F5F6FA">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Summary Dashboard -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <!-- NEW: Repayment Health Column -->
                </Grid.ColumnDefinitions>

                <!-- Total Approved -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Total Loan Approved" Foreground="#B0BEC5" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtTopTotalApproved" Text="₹ 0.00" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Total EMI Deducted -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Total EMI Deducted" Foreground="#B0BEC5" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtTopTotalEMI" Text="₹ 0.00" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Current Outstanding -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Current Outstanding Loan" Foreground="#B0BEC5" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtTopOutstanding" Text="₹ 0.00" Foreground="#FF5252" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- NEW: Repayment Health -->
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Repayment Health" Foreground="#B0BEC5" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtRepaymentFraction" Text="0 / 0 Paid" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>

                    <!-- Small colored blocks for the last 6 months -->
                    <ItemsControl x:Name="icLast6Months" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="16" Height="16" Background="{Binding Color}" CornerRadius="3" Margin="0,0,5,0" ToolTip="{Binding Month}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content: Unified Ledger Grid -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Monthly Loan &amp; Deduction Timeline" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

            <Border Grid.Row="1" BorderBrush="#D0D3D4" BorderThickness="1">
                <DataGrid x:Name="dgUnifiedLedger" AutoGenerateColumns="False" CanUserAddRows="False" 
                          HeadersVisibility="Column" Background="White" RowBackground="White" 
                          AlternatingRowBackground="#F9F9F9" GridLinesVisibility="Horizontal"
                          RowHeight="30" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Month / Year" Binding="{Binding MonthYear}" Width="*"/>
                        <DataGridTextColumn Header="Pending Loan Amount" Binding="{Binding LoanAmount}" Width="1.5*"/>

                        <!-- Custom Template for Red EMI Font -->
                        <DataGridTemplateColumn Header="EMI Deducted" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EmiAmount}" 
                                               Foreground="{Binding EmiColor}" 
                                               FontWeight="{Binding EmiWeight}" 
                                               VerticalAlignment="Center" Padding="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Bottom Totals -->
            <Border Grid.Row="2" Background="#EAEDED" BorderBrush="#D0D3D4" BorderThickness="1,0,1,1" Padding="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Final Pending: " FontWeight="Bold"/>
                    <TextBlock x:Name="txtBottomTotalGiven" Text="₹ 0.00" FontWeight="Bold" Margin="0,0,20,0"/>

                    <TextBlock Text="Total EMI: " FontWeight="Bold"/>
                    <TextBlock x:Name="txtBottomTotalEMI" Text="₹ 0.00" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Export Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0" x:Name="ActionPanel">
            <Button x:Name="btnExportExcel" Content="Export to Excel" Width="120" Height="35" Margin="0,0,10,0" 
                    Click="btnExportExcel_Click" Background="#27AE60" Foreground="White" FontWeight="Bold" 
                    BorderThickness="0" Cursor="Hand"/>

            <Button x:Name="btnExportPDF" Content="Save as PDF" Width="120" Height="35" 
                    Click="btnExportPDF_Click" Background="#E74C3C" Foreground="White" FontWeight="Bold" 
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>