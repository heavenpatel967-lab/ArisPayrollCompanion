<Window x:Class="ArisPayrollCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARIS Payroll Companion"
        Height="650"
        Width="1450"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="ARIS Payroll Companion"
            FontSize="30"
            FontWeight="Bold"
            Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="txtFolder"
                Height="36"
                VerticalContentAlignment="Center"
                Margin="0,0,10,0"/>

            <Button
                Grid.Column="1"
                x:Name="btnBrowse"
                Content="Browse"
                Height="36"
                Click="btnBrowse_Click"/>
        </Grid>

        <!-- 🔥 CHANGED TO WRAPPANEL: Prevents buttons from getting cut off if screen is too small -->
        <WrapPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Margin="0,20,0,20">

            <Button
                x:Name="btnTestConnection"
                Width="110"
                Height="40"
                Margin="0,0,8,8"
                Content="Test Connection"
                Click="btnTestConnection_Click"/>

            <Button
                x:Name="btnSync"
                Width="110"
                Height="40"
                Margin="0,0,8,8"
                Content="Sync Employees"
                Click="btnSync_Click"/>

            <Button
                x:Name="btnEmployees"
                Width="120"
                Height="40"
                Margin="0,0,8,8"
                Content="Employee List"
                Click="btnEmployees_Click"/>

            <Button
                x:Name="btnActiveLoansReport"
                Width="140"
                Height="40"
                Margin="0,0,8,8"
                Content="Active Loans"
                Click="btnActiveLoansReport_Click"
                Background="#27AE60" 
                Foreground="White" 
                FontWeight="Bold"
                Cursor="Hand"/>

            <Button
                x:Name="btnInactiveLoansReport"
                Width="140"
                Height="40"
                Margin="0,0,8,8"
                Content="Inactive &amp; Loans"
                Click="btnInactiveLoansReport_Click"
                Background="#D35400" 
                Foreground="White" 
                FontWeight="Bold"
                Cursor="Hand"/>

            <Button
                x:Name="btnCompliance"
                Width="130"
                Height="40"
                Margin="0,0,8,8"
                Content="Compliance"
                Click="btnCompliance_Click"
                Background="#E74C3C" 
                Foreground="White" 
                FontWeight="Bold"/>

            <Button
                x:Name="btnActiveLeaves"
                Width="130"
                Height="40"
                Margin="0,0,8,8"
                Content="Active Leaves"
                Click="btnActiveLeaves_Click"
                Background="#8E44AD" 
                Foreground="White" 
                FontWeight="Bold"
                Cursor="Hand"/>

            <Button x:Name="BtnImportAdvanceLimits" 
                Content="💸 Import Limits CSV" 
                Height="40" Width="150" 
                Background="#17A2B8" 
                Foreground="White" 
                FontWeight="Bold" 
                Click="BtnImportAdvanceLimits_Click" 
                Cursor="Hand" 
                Margin="0,0,8,8"/>

            <Button x:Name="btnDailyReports"
                Content="📅 Daily Attendance Reports" 
                Height="40" Width="200" 
                Background="#F39C12" 
                Foreground="White" 
                FontWeight="Bold" 
                Click="BtnDailyReports_Click" 
                Cursor="Hand"
                Margin="0,0,8,8"/>

            <!-- 🔥 NEW: Employee History Report Button -->
            <Button x:Name="btnHistoryReport"
                Content="📆 Employee History" 
                Height="40" Width="160" 
                Background="#34495E" 
                Foreground="White" 
                FontWeight="Bold" 
                Click="BtnHistoryReport_Click" 
                Cursor="Hand"
                Margin="0,0,8,8"/>

        </WrapPanel>

        <GroupBox
            Grid.Row="3"
            Header="Status">

            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="txtStatus"
                    FontSize="15"
                    FontWeight="SemiBold"/>

                <TextBox
                    Grid.Row="1"
                    x:Name="txtLog"
                    Margin="0,10,0,0"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    FontFamily="Consolas"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>